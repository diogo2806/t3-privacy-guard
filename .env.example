# Copy values only to your deployment environment. Never commit real secrets.
# Sensitive placeholders beginning with replace-with- are documentation-only sentinels and are rejected by runtime/setup validation.
# Frontend-only Nginx upstream. The browser continues to call same-origin /api/*; Nginx proxies to this backend origin.
# For the current multi-server EasyPanel deployment use: https://api-privacy.iforce.com.br
BACKEND_BASE_URL=https://api-privacy.iforce.com.br
T3N_API_KEY=replace-with-tenant-private-key
# Proposal Agent: evaluate-action only. Never grant protected remediation functions to this principal.
T3N_AGENT_API_KEY=replace-with-separate-proposal-agent-private-key
# Protected Executor: execute-remediation + verify-remediation only. Must differ from tenant/proposal credentials.
T3N_EXECUTOR_API_KEY=replace-with-separate-protected-executor-private-key
T3N_NETWORK=testnet
T3N_GATEWAY_PORT=3001
T3N_GATEWAY_URL=http://t3n-gateway:3001
T3N_CONTRACT_TAIL=privacy-guard
T3N_CONTRACT_VERSION=0.4.0
T3N_CONTRACT_NUMERIC_ID=replace-after-registration
# Runtime artifact embedded by t3n-gateway/Dockerfile. Do not point production at a local Rust target/ directory.
T3N_CONTRACT_WASM_PATH=contracts/privacy_guard_contract.wasm
T3N_POLICY_FILE=policy/privacy-guard-policy.json
# Operational provisioning order inside the production gateway container:
# npm run runtime:preflight
# npm run contract:register -> persist the emitted numericContractId as T3N_CONTRACT_NUMERIC_ID
# npm run contract:setup-policy
# npm run contract:setup-remediation
# npm run agent:card:publish
# npm run agent:card:verify
# See t3n-gateway/PROVISIONING.md for the complete deploy/setup procedure.
# Optional. When set, it must be the externally reachable HTTPS /a2a endpoint.
# Example: https://privacy-guard.example/a2a
# The gateway then exposes /.well-known/agent-card.json and advertises A2A in the public T3N Agent Card.
# A2A exposes policy evaluation only; human authorization, trusted normal payload values and protected remediation are never exposed here.
A2A_PUBLIC_URL=
SECURITY_API_KEY=replace-with-synthetic-or-real-remediation-key
# Full private action URL. The human proof binds only its canonical hostname; URL/path never leave the protected configuration surface.
# example.invalid is a non-operational placeholder and is intentionally reported as Enterprise integration INCOMPLETE.
SECURITY_API_URL=https://example.invalid/remediation
# Independent read-back endpoint; it may use a different host from the approved side-effect destination.
# Replace example.invalid with the real HTTPS read-back host before Enterprise integration can become READY.
SECURITY_VERIFICATION_URL=https://example.invalid/remediation/status
# Testnet-only controlled negative: approve host A, temporarily resolve the private action URL to host B, require pre-egress rejection, then restore A.
EVIDENCE_RUN_DESTINATION_BINDING=false
EVIDENCE_DESTINATION_B_URL=https://second-example.invalid/remediation
# Testnet-only controlled proof: external read-back returns only booleans proving an allowed synthetic sentinel arrived and a REDACTed sentinel did not.
EVIDENCE_RUN_PAYLOAD_MINIMIZATION=false
# Testnet-only private-profile proof. Keep false unless a compatible synthetic T3N profile and controlled endpoints are available.
EVIDENCE_RUN_PROFILE_PLACEHOLDER=false
# One-time v2 proof generated by the authenticated backend human-authorization flow for the fixed synthetic notify-security request.
# Treat as a secret: never commit it and never write it to evidence. The script refuses to bypass the #128 proof boundary.
EVIDENCE_NOTIFICATION_AUTHORIZATION_PROOF=
GATEWAY_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Canonical/recommended: Ed25519 PKCS#8 private key DER encoded as standard base64.
# Backend also accepts PKCS#8 PEM or the complete PKCS#8 PEM encoded as base64 for single-line container environment variables.
# Compatibility only: a single base64 binary bundle containing PKCS#8 DER followed by its matching Ed25519 SPKI DER is accepted after pair verification.
# Never provision the private key or that bundle to the gateway; REMEDIATION_AUTH_PUBLIC_KEY_SPKI remains public-key-only.
REMEDIATION_AUTH_PRIVATE_KEY_PKCS8=replace-with-base64-pkcs8-ed25519-private-key
# Canonical/recommended: matching Ed25519 SPKI public key DER encoded as standard base64.
# Gateway also accepts SPKI PEM or the complete SPKI PEM encoded as base64 and normalizes it to DER/base64 before use.
# Gateway fail-fast + T3N contract verification only.
REMEDIATION_AUTH_PUBLIC_KEY_SPKI=replace-with-base64-spki-ed25519-public-key
# Version identifier embedded in every proof and used to resolve remediation_auth_public_key_spki:<keyId> from private T3N KV.
REMEDIATION_AUTH_KEY_ID=primary
# Optional bounded rotation overlap. Configure all three values together only while already-issued proofs for the previous key expire.
# The grace window is enforced inside WASM and is limited to 1..300 seconds; the previous private key is never provisioned to gateway/T3N.
REMEDIATION_AUTH_PREVIOUS_KEY_ID=
REMEDIATION_AUTH_PREVIOUS_PUBLIC_KEY_SPKI=
REMEDIATION_AUTH_PREVIOUS_KEY_GRACE_SECONDS=
REMEDIATION_CAPABILITY_TTL_SECONDS=60
# Gateway-only fail-fast replay cache. The authoritative second replay check is the private T3N KV map created by contract:setup-remediation.
REMEDIATION_REPLAY_STORE_PATH=/data/remediation-capability-nonces.json
T3N_TRUST_FLOOR_STORE_PATH=/data/t3n-trust-floor.json
# Backend-only HMAC key for tamper-evident local audit. Keep it distinct from all other runtime credentials.
AUDIT_INTEGRITY_KEY=replace-with-distinct-at-least-32-random-characters
AUDIT_INTEGRITY_KEY_ID=primary
# Retain historical keyId=secret entries only while old retained audit events still require verification.
AUDIT_INTEGRITY_PREVIOUS_KEYS=
# Legacy rows are never silently promoted to a new authenticated trust root.
AUDIT_INTEGRITY_ALLOW_LEGACY_BOOTSTRAP=false
AI_PROVIDER=disabled
# Remote AI providers require HTTPS. Plain HTTP is accepted only for explicit loopback development endpoints.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
# Local/demo mode: one application principal receives ANALYST, APPROVER, EXECUTOR and AUDITOR for backwards-compatible demos.
# This mode is not presented as enterprise IAM or separation-of-duties compliance.
OPERATOR_USERNAME=replace-with-operator-username
OPERATOR_PASSWORD=replace-with-strong-operator-password
# Enterprise SoD mode fails closed unless all four role-specific principals are configured and distinct.
# Roles are enforced server-side: ANALYST mutates analysis/evaluation, APPROVER authorizes, EXECUTOR executes/verifies, AUDITOR is read-only.
ENTERPRISE_SOD_ENABLED=false
ANALYST_USERNAME=replace-with-analyst-username
ANALYST_PASSWORD=replace-with-strong-analyst-password
APPROVER_USERNAME=replace-with-approver-username
APPROVER_PASSWORD=replace-with-strong-approver-password
EXECUTOR_USERNAME=replace-with-executor-username
EXECUTOR_PASSWORD=replace-with-strong-executor-password
AUDITOR_USERNAME=replace-with-auditor-username
AUDITOR_PASSWORD=replace-with-strong-auditor-password
OPERATOR_SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=true
# Optional machine-to-machine incident intake. It is backend-only and disabled by default.
# Configure integrations as a JSON array with id, display name and a unique 32-512 character runtime token.
# Keep these credentials distinct from operator, T3N, gateway and remediation credentials. Never expose them to the frontend.
# Example shape: [{"id":"security-automation","name":"Security automation","token":"<runtime-secret>"}]
INCIDENT_INTAKE_ENABLED=false
INCIDENT_INTAKE_INTEGRATIONS_JSON=[]
# Optional hot-reload source for revocation/rotation without application restart. Configure this OR the JSON above, never both.
# Mount a backend-only JSON file using the same array shape. It is re-read on each intake authentication; missing/invalid content fails closed.
INCIDENT_INTAKE_CREDENTIALS_FILE=
# Incident retention is server-controlled. Valid retention range: 1-30 days.
# At expiresAt <= now, incident reads including audit-evidence return 404 immediately; purge timing controls only physical deletion.
INCIDENT_RETENTION_DAYS=7
INCIDENT_PURGE_INITIAL_DELAY_MS=60000
INCIDENT_PURGE_INTERVAL_MS=900000
