# Configuration of the two services: guard-runtime and app (backend API + dashboard + MCP).
# Copy values only to your deployment environment and never commit real secrets. Values starting with replace-with-
# are documentation placeholders and are rejected at startup. For a local stack, deploy/local/init-env.sh generates
# every secret below.

# =====================================================================================================================
# Shared by both services
# =====================================================================================================================

# guard-runtime caller tokens, 32-512 random characters each and all different. The proposal caller may only evaluate;
# the executor may only execute and verify. guard-runtime receives them inside GUARD_RUNTIME_CALLERS_JSON below.
GUARD_RUNTIME_PROPOSAL_TOKEN=replace-with-at-least-32-random-characters
GUARD_RUNTIME_EXECUTOR_TOKEN=replace-with-at-least-32-random-characters
# Optional third caller granted only manage-policy, used by the dashboard's Policy tab to publish and roll back
# versions. Leave empty (and out of GUARD_RUNTIME_CALLERS_JSON) to keep the policy read-only.
GUARD_RUNTIME_POLICY_ADMIN_TOKEN=

# Credential guard-runtime sends to the security API. The app needs the same value only when its built-in adapter
# (/api/security/remediation/*) plays the security API, as in the local stack.
SECURITY_API_KEY=

# Ed25519 key pair for the one-time human authorization capability: the app signs with the private key, guard-runtime
# verifies with the public key. Standard base64 of the DER encoding (PEM is also accepted). The private key never goes
# to guard-runtime.
REMEDIATION_AUTH_PRIVATE_KEY_PKCS8=replace-with-base64-pkcs8-ed25519-private-key
REMEDIATION_AUTH_PUBLIC_KEY_SPKI=replace-with-base64-spki-ed25519-public-key
REMEDIATION_AUTH_KEY_ID=primary

# =====================================================================================================================
# guard-runtime
# =====================================================================================================================

GUARD_RUNTIME_PORT=3101
# Policy document (actions, purposes, allowed fields, hosts and private references); missing or invalid fails closed.
# Example: deploy/local/policy.json. Without GUARD_RUNTIME_POLICY_DIR this file is the policy, re-read on every call.
GUARD_RUNTIME_POLICY_FILE=/config/policy.json
# Versioned policy: immutable versions plus a hash-chained history in this directory, published and rolled back through
# the manage-policy caller. The file above then only seeds a version not published yet. Back it up with the volume.
GUARD_RUNTIME_POLICY_DIR=/data/policy
# Callers and the functions each may call. Use the two tokens above.
GUARD_RUNTIME_CALLERS_JSON=[{"id":"agent:proposal","token":"<GUARD_RUNTIME_PROPOSAL_TOKEN>","functions":["evaluate-action"]},{"id":"agent:executor","token":"<GUARD_RUNTIME_EXECUTOR_TOKEN>","functions":["execute-remediation","verify-remediation"]},{"id":"agent:policy-admin","token":"<GUARD_RUNTIME_POLICY_ADMIN_TOKEN>","functions":["manage-policy"]}]
# Persistent files: consumed capability nonces and the hash-chained activity log. Back them up with the volume.
GUARD_RUNTIME_REPLAY_FILE=/data/replay/execution-nonces.json
GUARD_RUNTIME_ACTIVITY_FILE=/data/activity/activity.jsonl
GUARD_RUNTIME_TENANT_ID=default
# Private value behind the logical reference verified_email. Only guard-runtime holds it, and it is substituted only
# in the outbound request to the security API.
GUARD_RUNTIME_VERIFIED_EMAIL=
# Security API that performs and confirms remediation. HTTPS and no explicit port. The hostnames must be in the
# policy's allowed_hosts for the remediation actions.
SECURITY_API_URL=
SECURITY_VERIFICATION_URL=
# Previous capability key during a rotation, all three together (grace 1-300 s from startup).
REMEDIATION_AUTH_PREVIOUS_KEY_ID=
REMEDIATION_AUTH_PREVIOUS_PUBLIC_KEY_SPKI=
REMEDIATION_AUTH_PREVIOUS_KEY_GRACE_SECONDS=
GUARD_RUNTIME_EGRESS_TIMEOUT_MS=15000
# Local development only: allows http:// and explicit ports for the security API.
GUARD_RUNTIME_ALLOW_INSECURE_HTTP=false

# =====================================================================================================================
# app
# =====================================================================================================================

# Database. Production: PostgreSQL with the "postgres" profile, which builds the schema from the versioned Flyway
# migrations and validates it against the code at startup. Without the profile the app uses an H2 file under /data,
# fine for evaluation and the local stack.
# SPRING_PROFILES_ACTIVE=postgres
# DATABASE_URL=jdbc:postgresql://postgres:5432/privacyguard
DATABASE_URL=jdbc:h2:file:/data/privacyguard;AUTO_SERVER=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# guard-runtime on the private network: base URL without credentials or query, and the caller ids matching
# GUARD_RUNTIME_CALLERS_JSON.
GUARD_RUNTIME_URL=http://guard-runtime:3101
GUARD_RUNTIME_PROPOSAL_AGENT_ID=agent:proposal
GUARD_RUNTIME_EXECUTOR_ID=agent:executor
GUARD_RUNTIME_TIMEOUT_MS=15000

# Lifetime of a signed capability between human authorization and execution.
REMEDIATION_CAPABILITY_TTL_SECONDS=60

# HMAC key for the tamper-evident audit chain, distinct from every other secret. Keep old keyId=secret pairs in
# AUDIT_INTEGRITY_PREVIOUS_KEYS only while retained events still need them.
AUDIT_INTEGRITY_KEY=replace-with-distinct-at-least-32-random-characters
AUDIT_INTEGRITY_KEY_ID=primary
AUDIT_INTEGRITY_PREVIOUS_KEYS=
AUDIT_INTEGRITY_ALLOW_LEGACY_BOOTSTRAP=false

# Bearer token for agents calling /mcp (32-512 characters). Empty disables the MCP endpoint.
MCP_TOKEN=

# Optional AI provider for "Ask agent": any OpenAI-compatible chat-completions endpoint (OpenAI, Azure OpenAI, a
# gateway in front of Claude or Gemini, or a local Ollama/vLLM server). The model only proposes; guard-runtime decides.
# Remote endpoints must use HTTPS; plain HTTP is accepted for loopback, or for internal hosts with AI_ALLOW_INSECURE_HTTP.
AI_PROVIDER=disabled
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
AI_ALLOW_INSECURE_HTTP=false

# Single operator mode: this account holds every role (ANALYST, APPROVER, EXECUTOR, AUDITOR, POLICY_ADMIN). Fine for
# evaluation, not separation of duties.
OPERATOR_USERNAME=replace-with-operator-username
OPERATOR_PASSWORD=replace-with-strong-operator-password
# Separation of duties: four distinct accounts, all required when enabled. The account that authorizes a remediation
# can never execute or verify it.
ENTERPRISE_SOD_ENABLED=false
ANALYST_USERNAME=replace-with-analyst-username
ANALYST_PASSWORD=replace-with-strong-analyst-password
APPROVER_USERNAME=replace-with-approver-username
APPROVER_PASSWORD=replace-with-strong-approver-password
EXECUTOR_USERNAME=replace-with-executor-username
EXECUTOR_PASSWORD=replace-with-strong-executor-password
AUDITOR_USERNAME=replace-with-auditor-username
AUDITOR_PASSWORD=replace-with-strong-auditor-password
# Optional fifth account that may publish and roll back policy versions; distinct from the four above. Leave both empty
# to keep policy changes out of the dashboard in this mode (AUDITOR can still read the policy).
POLICY_ADMIN_USERNAME=
POLICY_ADMIN_PASSWORD=
# Single sign-on with OpenID Connect (Entra ID, Okta, Keycloak, Google Workspace...). Register Privacy Guard in the
# provider with redirect URI https://<app-domain>/login/oauth2/code/sso, then set the issuer and client below. The
# provider authenticates (and enforces MFA); OIDC_ROLE_MAPPING decides the roles from the groups claim. With SSO on,
# the session cookie becomes SameSite=Lax so the provider's redirect back keeps the session.
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid,profile,email
OIDC_USERNAME_CLAIM=preferred_username
# Claim with the user's groups/roles; dotted path for nested claims (Keycloak: realm_access.roles).
OIDC_ROLES_CLAIM=groups
# JSON from role to the claim values that grant it. Entra ID sends group object ids here.
OIDC_ROLE_MAPPING={"ANALYST":["soc-analysts"],"APPROVER":["soc-approvers"],"EXECUTOR":["soc-executors"],"AUDITOR":["auditors"],"POLICY_ADMIN":["privacy-admins"]}
# false: single sign-on is the only way in, and the local accounts above are not needed.
LOCAL_LOGIN_ENABLED=true
OPERATOR_SESSION_TIMEOUT=30m
# true behind HTTPS (production); false only for plain-HTTP local use.
SESSION_COOKIE_SECURE=true

# Optional machine-to-machine incident intake (POST /api/integrations/incidents with a Bearer token), disabled by
# default. JSON array of {"id","name","token"} with unique 32-512 character tokens, or a file with the same shape that
# is re-read on every request (for rotation without restart). Configure one of the two, never both.
INCIDENT_INTAKE_ENABLED=false
INCIDENT_INTAKE_INTEGRATIONS_JSON=[]
INCIDENT_INTAKE_CREDENTIALS_FILE=

# Incident retention, 1-30 days. Expired incidents are unreadable immediately; the purge job deletes them physically.
INCIDENT_RETENTION_DAYS=7
INCIDENT_PURGE_INITIAL_DELAY_MS=60000
INCIDENT_PURGE_INTERVAL_MS=900000
