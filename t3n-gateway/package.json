{
  "name": "t3-privacy-guard-gateway",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "runtime:preflight": "node dist/scripts/runtime-preflight.js",
    "contract:register": "node dist/scripts/register-contract.js",
    "contract:setup-policy": "node dist/scripts/setup-policy.js",
    "contract:setup-remediation": "node dist/scripts/setup-remediation-secrets.js",
    "agent:card:verify": "node dist/scripts/agent-card-verify.js",
    "agent:card:publish": "node dist/scripts/agent-card-publish.js",
    "evidence:testnet": "tsx src/scripts/adversarial-testnet.ts && tsx src/scripts/human-proof-testnet.ts && tsx src/scripts/profile-placeholder-evidence.ts",
    "evidence:human-proof": "tsx src/scripts/human-proof-testnet.ts",
    "evidence:profile-placeholder": "tsx src/scripts/profile-placeholder-evidence.ts",
    "evidence:live": "tsx src/scripts/live-evidence.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@terminal3/t3n-sdk": "5.2.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/express-serve-static-core": "5.0.7",
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
