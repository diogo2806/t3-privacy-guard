{
  "name": "t3-privacy-guard-gateway",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "contract:register": "tsx src/scripts/register-contract.ts",
    "contract:setup-remediation": "tsx src/scripts/setup-remediation-secrets.ts",
    "agent:card:verify": "tsx src/scripts/agent-card-verify.ts",
    "agent:card:publish": "tsx src/scripts/agent-card-publish.ts",
    "evidence:testnet": "tsx src/scripts/adversarial-testnet.ts",
    "evidence:live": "tsx src/scripts/live-evidence.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@terminal3/t3n-sdk": "5.2.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
