package z:privacy-guard@0.1.0;

world privacy-guard {
    export contracts;
}

interface contracts {
    record generic-input {
        input: option<list<u8>>,
        user-profile: option<list<u8>>,
        context: option<list<u8>>,
    }

    /// Evaluate a proposed incident-response action inside the TEE.
    /// Input: PolicyEvaluationRequest JSON.
    /// Output: PolicyDecision JSON with ALLOW, REDACT or DENY.
    evaluate-action: func(req: generic-input) -> result<list<u8>, string>;
}
